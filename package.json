{
  "name": "weq",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "description": "QQ NT 本地聊天记录解密、导出、查看与年度报告",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @weq/desktop dev",
    "build": "pnpm run build:bot && pnpm --filter @weq/desktop build",
    "build:bot": "esbuild packages/bot/src/index.ts --bundle --platform=node --format=esm --external:bufferutil --external:utf-8-validate --banner:js=\"import { createRequire as __cjs_createRequire } from 'node:module'; const require = __cjs_createRequire(import.meta.url);\" --outfile=resources/bot-runtime/bot.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --no-sort --no-bail --workspace-concurrency=2 test --maxWorkers=2 --minWorkers=1",
    "test:fail-fast": "pnpm -r --no-sort --workspace-concurrency=2 test --maxWorkers=2 --minWorkers=1 --bail=1",
    "test:changed": "pnpm -r --no-sort --workspace-concurrency=2 test --changed --passWithNoTests --maxWorkers=2 --minWorkers=1 --bail=1",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "ci:local": "node scripts/ci-local.mjs",
    "native:fetch": "node scripts/fetch-native.mjs",
    "native:check": "node scripts/fetch-native.mjs --check",
    "native:preflight": "node scripts/fetch-native.mjs --check --require-fresh --require-authorization --verify",
    "native:check-streaming": "node scripts/check-native-streaming.mjs",
    "native:check-key-scan": "node scripts/check-native-key-scan.mjs",
    "version:set": "node scripts/set-version.mjs",
    "mface:fetch": "node scripts/parcel_crawler.mjs",
    "rpskin:fetch": "tsx scripts/fetch_red_pack_skins.ts",
    "sso:send": "tsx scripts/sso_send.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3"
  }
}
