{
  "name": "weq",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "description": "QQ NT 本地聊天记录解密、导出、查看与年度报告",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:bot && pnpm --filter @weq/desktop build",
    "build:bot": "node scripts/build-bot.mjs",
    "build:weqbot-daemon": "node scripts/build-weqbot-daemon.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --no-sort --no-bail --workspace-concurrency=2 test --maxWorkers=2 --minWorkers=1",
    "test:fail-fast": "pnpm -r --no-sort --workspace-concurrency=2 test --maxWorkers=2 --minWorkers=1 --bail=1",
    "test:changed": "pnpm -r --no-sort --workspace-concurrency=2 test --changed --passWithNoTests --maxWorkers=2 --minWorkers=1 --bail=1",
    "test:dev-bootstrap": "node --test scripts/dev.test.mjs scripts/dev-web.test.mjs scripts/dev-native.test.mjs scripts/prepare-remote-network.test.mjs scripts/prepare-dev-electron.test.mjs",
    "test:dev-integration": "node --test scripts/dev-web.integration.test.mjs scripts/dev-electron.integration.test.mjs",
    "test:ci-scripts": "node --test scripts/test-ci.test.mjs scripts/check-docs-submodule.test.mjs scripts/extract-changelog.test.mjs scripts/publish-aur.test.mjs scripts/enhancement-metadata.test.mjs scripts/publish-release-feed.test.mjs scripts/publish-announcements.test.mjs",
    "test:packaging-scripts": "node --test scripts/prepare-enhancement-engines.test.mjs scripts/build-weqbot-daemon.test.mjs",
    "browser:install": "playwright install chromium webkit",
    "browser:check": "node scripts/browser-runtime.mjs",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test:export-schema": "node --test schemas/export/v1/contract.test.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "native:fetch": "node scripts/fetch-native.mjs",
    "native:check": "node scripts/fetch-native.mjs --check",
    "native:preflight": "node scripts/fetch-native.mjs --check --require-fresh --require-authorization --verify",
    "docs:install": "pnpm --dir docs install --frozen-lockfile --prefer-offline",
    "docs:dev": "pnpm --dir docs dev",
    "docs:check": "pnpm --dir docs check",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview",
    "docs:versions": "node scripts/sync-docs-versions.mjs",
    "docs:versions:check": "node scripts/sync-docs-versions.mjs --check",
    "docs:anonymize": "node scripts/anonymize-docs.mjs",
    "docs:anonymize:check": "node scripts/anonymize-docs.mjs --check",
    "native:check-streaming": "node scripts/check-native-streaming.mjs",
    "native:check-key-scan": "node scripts/check-native-key-scan.mjs",
    "version:set": "node scripts/set-version.mjs",
    "rpskin:fetch": "tsx scripts/fetch_red_pack_skins.ts",
    "sso:send": "tsx scripts/sso_send.ts",
    "sign:probe": "tsx scripts/probe-sign.ts",
    "versions:refresh": "tsx scripts/refresh-qq-versions.mts",
    "settings:docs": "tsx scripts/sync-settings-docs.ts",
    "settings:docs:check": "tsx scripts/sync-settings-docs.ts --check",
    "features:docs": "tsx scripts/sync-feature-docs.ts",
    "features:docs:check": "tsx scripts/sync-feature-docs.ts --check && tsx --test scripts/sync-feature-docs.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^24.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "^0.28.1",
    "playwright": "1.65.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3"
  }
}
