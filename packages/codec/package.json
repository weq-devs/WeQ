{
  "name": "@weq/codec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./raw": "./src/raw/index.ts",
    "./dictionary": "./src/dictionary/index.ts",
    "./element": "./src/element/index.ts",
    "./domain": "./src/domain/index.ts",
    "./proto/*": "./src/proto/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tools:scan-element-types": "tsx tools/scan-element-types.ts",
    "tools:search-string": "tsx tools/search-string.ts",
    "tools:emoji-decode": "tsx tools/test-emoji-decode.ts",
    "mutate:ark-modify": "tsx tools/mutate/test-ark-modify.ts"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "better-sqlite3": "^12.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@weq/testkit": "workspace:*",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
