{
  "name": "@weq/daemon",
  "version": "1.0.1",
  "private": true,
  "description": "Rust 守护进程源码包 —— 编译产物是平台原生二进制（无 Node 运行时依赖），由 scripts/build.mjs 构建进 resources/daemon/<platform>-<arch>/ 随安装包发布",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "test": "cargo test"
  }
}
