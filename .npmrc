# Use the workspace's pinned pnpm version
package-manager-strict=true

# Hoist Electron + Tailwind binaries deep enough for tooling that
# does not respect pnpm's symlink layout (electron-builder, vite plugins).
public-hoist-pattern[]=electron
public-hoist-pattern[]=*@tailwindcss/*

# Mirror Electron + electron-builder binary downloads through npmmirror.
# Direct downloads from github.com/electron releases ECONNRESET in CN.
# Override per-shell with `ELECTRON_MIRROR=... pnpm i` if these stop working.
#
# 注意：electron 包本身走 npm 配置（electron_mirror / electron_custom_dir），
# 但真正下载二进制的是 @electron/get，它只认 ELECTRON_MIRROR / ELECTRON_CUSTOM_DIR
# 环境变量。两者都留，否则二进制下载会退回 GitHub 并静默失败。
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
electron_builder_binaries_mirror=https://registry.npmmirror.com/-/binary/electron-builder-binaries/
electron_custom_dir={{ version }}
ELECTRON_MIRROR=https://registry.npmmirror.com/-/binary/electron/
ELECTRON_CUSTOM_DIR={{ version }}
