# dependencies
node_modules/
.pnpm-store/

# build output
dist/
out/
build/
*.tsbuildinfo

# 例外：electron-builder 的 buildResources 就落在 apps/desktop/build（见
# electron-builder.yml 的 directories.buildResources），那里放的是**要入库的打包
# 脚本**（installer.nsh：卸载时清理 weq-daemon 的钩子），不是构建产物。
!apps/desktop/build/
!apps/desktop/build/**

# weq web runtime dirs (exports / logs, created next to the server)
weq-exports/
weq-data/


# editor / OS
.DS_Store
Thumbs.db
.idea/
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# env / secrets
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# electron-builder
release/

# Rust daemon build output (staged into resources/daemon/ by build:daemon,
# packaged at release time — never committed)
packages/daemon/target/
resources/daemon/


# extend
.claude/
.agents/
.codex/
# 导出 bot 的预打包引擎（由 pnpm build:bot 生成）
resources/bot-runtime/

# NineBird 注入 QQ 的 loader 脚本（由 pnpm build:ninebird 从 packages/ninebird 生成）
resources/ninebird-runtime/

# dev
/tmp
/docs/develop/redbag.md

# nt_helper 原生产物：5 个平台的 nt_helper.node 与加密后的装扮资源（*.dat）都不入库。
# 前者由 native 私仓构建、发布到公开仓 H3CoF6/nt_helper_release，主仓用
# `pnpm native:fetch` 取最新（release 流水线在打包前也会取一次）。
# 注意：native/<platform>/<arch>/ninebird/* 仍然入库，是另一条手工同步的链。
/native/*/*/nt_helper.node
# `pnpm native:fetch` 记「当前装的是哪个 tag」用，天然是机器相关的
/native/.installed.json
/resources/dress/*.dat

# 装扮资源抓取脚本的中间产物（私有）
/resources/dress/*_resources
# 红包皮肤元数据由 `pnpm rpskin:fetch` 抓取，是**要入库**的长期数据
# （resources/redpack/skins.json），所以这里刻意不 ignore。

