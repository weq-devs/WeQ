{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weq.local/schemas/export/v1/directory.basic.schema.json",
  "title": "联系人、群与成员基本内容",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "kind": {
          "const": "directory"
        },
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "required": ["type", "subject", "name"],
      "properties": {
        "type": {
          "enum": ["contact", "group", "member", "category"]
        },
        "subject": {
          "$ref": "common.schema.json#/$defs/actor"
        },
        "name": {
          "type": "string"
        },
        "remark": {
          "type": "string"
        },
        "parentId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "categoryIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "role": {
          "type": "string"
        },
        "avatarResources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "member"
              }
            }
          },
          "then": {
            "required": ["parentId"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
