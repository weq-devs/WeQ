{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weq.local/schemas/export/v1/mail.basic.schema.json",
  "title": "邮箱基本内容",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "kind": {
          "const": "mail"
        },
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "mailId",
        "sender",
        "to",
        "cc",
        "bcc",
        "sentAt",
        "subject",
        "content",
        "attachments"
      ],
      "properties": {
        "mailId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "messageId": {
          "type": ["string", "null"]
        },
        "sender": {
          "$ref": "common.schema.json#/$defs/actor"
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/actor"
          }
        },
        "cc": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/actor"
          }
        },
        "bcc": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/actor"
          }
        },
        "replyTo": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "sentAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "type": "string"
        },
        "threadId": {
          "type": ["string", "null"]
        },
        "inReplyTo": {
          "type": ["string", "null"]
        },
        "content": {
          "$ref": "common.schema.json#/$defs/content"
        },
        "attachments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "inlineResources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cid", "resourceId"],
            "properties": {
              "cid": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "resourceId": {
                "$ref": "common.schema.json#/$defs/id"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
