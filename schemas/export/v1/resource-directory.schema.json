{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weq.local/schemas/export/v1/resource-directory.schema.json",
  "title": "资源目录记录（基本内容与可选附加数据）",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "kind": {
          "const": "resource-directory"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "native": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/native"
            },
            {
              "properties": {
                "attributes": {
                  "items": {
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "size"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["integer", "text"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "total"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["integer", "text"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "unread"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["integer", "text"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "price"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["integer", "text"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "version"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["integer", "text"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "locked"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["boolean"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "available"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["boolean"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "downloaded"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["boolean"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "uploader"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["json"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "permissions"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["json"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "classification"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["json"]
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "required": ["type", "sourceId", "owner", "name", "resourceIds"],
      "properties": {
        "type": {
          "enum": [
            "folder",
            "file",
            "album",
            "photo",
            "video",
            "emoji-pack",
            "emoji",
            "bubble",
            "font",
            "widget",
            "artifact",
            "report",
            "bot-package"
          ]
        },
        "sourceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/actor"
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "createdAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "resourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
