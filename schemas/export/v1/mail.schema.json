{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weq.local/schemas/export/v1/mail.schema.json",
  "title": "邮箱记录（基本内容与可选附加数据）",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "kind": {
          "const": "mail"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "native": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/native"
            },
            {
              "properties": {
                "attributes": {
                  "items": {
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "folderIds"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["json"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "labels"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["json"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "headers"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["json"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "mimeProperties"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["json"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "unread"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["boolean"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "starred"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["boolean"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "draft"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["boolean"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "size"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["integer"]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "snippet"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "value": {
                              "properties": {
                                "type": {
                                  "enum": ["text"]
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "mailId",
        "sender",
        "to",
        "cc",
        "bcc",
        "sentAt",
        "subject",
        "content",
        "attachments"
      ],
      "properties": {
        "mailId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "messageId": {
          "type": ["string", "null"]
        },
        "sender": {
          "$ref": "common.schema.json#/$defs/actor"
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/actor"
          }
        },
        "cc": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/actor"
          }
        },
        "bcc": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/actor"
          }
        },
        "replyTo": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "sentAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "type": "string"
        },
        "threadId": {
          "type": ["string", "null"]
        },
        "inReplyTo": {
          "type": ["string", "null"]
        },
        "content": {
          "$ref": "common.schema.json#/$defs/content"
        },
        "attachments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "inlineResources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cid", "resourceId"],
            "properties": {
              "cid": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "resourceId": {
                "$ref": "common.schema.json#/$defs/id"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
