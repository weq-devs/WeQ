{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weq.local/schemas/export/v1/archive.schema.json",
  "title": "WeQ JSON 正式归档（待实现设计）",
  "allOf": [
    { "$ref": "#/$defs/header" },
    {
      "type": "object",
      "required": ["records", "observations", "resources"],
      "properties": {
        "records": { "type": "array" },
        "observations": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/observation" }
        },
        "resources": { "type": "array" }
      },
      "allOf": [
        {
          "if": { "properties": { "profile": { "const": "basic" } } },
          "then": {
            "properties": {
              "records": { "items": { "$ref": "#/$defs/basicRecord" } },
              "resources": { "items": { "$ref": "#/$defs/basicResource" } }
            }
          },
          "else": {
            "properties": {
              "records": { "items": { "$ref": "#/$defs/fullRecord" } },
              "resources": { "items": { "$ref": "#/$defs/fullResource" } }
            }
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "header": {
      "type": "object",
      "required": ["format", "version", "profile", "archiveId", "scope", "formats", "incremental"],
      "properties": {
        "format": { "const": "weq-export" },
        "version": { "const": "1.0" },
        "profile": { "enum": ["basic", "full"] },
        "archiveId": { "$ref": "common.schema.json#/$defs/id" },
        "scope": {
          "type": "object",
          "required": ["account", "selection"],
          "properties": {
            "account": { "$ref": "common.schema.json#/$defs/actor" },
            "partition": { "$ref": "common.schema.json#/$defs/id" },
            "selection": { "$ref": "common.schema.json#/$defs/value" }
          },
          "additionalProperties": false
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["json", "jsonl"] }
        },
        "incremental": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "authority": { "enum": ["json", "jsonl"] }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } } },
              "then": { "required": ["authority"] },
              "else": { "not": { "required": ["authority"] } }
            }
          ],
          "additionalProperties": false
        },
        "externalReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "reason"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "kind": { "$ref": "common.schema.json#/$defs/id" },
              "reason": { "enum": ["not-selected", "unavailable"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "basicRecord": {
      "oneOf": [
        { "$ref": "message.basic.schema.json" },
        { "$ref": "qzone.basic.schema.json" },
        { "$ref": "collection.basic.schema.json" },
        { "$ref": "mail.basic.schema.json" },
        { "$ref": "directory.basic.schema.json" },
        { "$ref": "generated.basic.schema.json" },
        { "$ref": "resource-directory.basic.schema.json" }
      ]
    },
    "fullRecord": {
      "oneOf": [
        { "$ref": "message.full.schema.json" },
        { "$ref": "qzone.full.schema.json" },
        { "$ref": "collection.full.schema.json" },
        { "$ref": "mail.full.schema.json" },
        { "$ref": "directory.full.schema.json" },
        { "$ref": "generated.full.schema.json" },
        { "$ref": "resource-directory.full.schema.json" }
      ]
    },
    "basicResource": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/resource" }],
      "unevaluatedProperties": false
    },
    "fullResource": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/resource" },
        {
          "required": ["native", "source"],
          "properties": {
            "native": { "$ref": "common.schema.json#/$defs/native" },
            "source": { "$ref": "common.schema.json#/$defs/source" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
