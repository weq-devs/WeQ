  "unevaluatedProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "required": ["type", "subject", "name"],
      "properties": {
        "type": {
          "enum": ["contact", "group", "member", "category"]
        },
        "subject": {
          "$ref": "common.schema.json#/$defs/actor"
        },
        "name": {
          "type": "string"
        },
        "remark": {
          "type": "string"
        },
        "parentId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "categoryIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "role": {
          "type": "string"
        },
        "avatarResources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "member"
              }
            }
          },
          "then": {
            "required": ["parentId"]
          }
        }
      ],
