{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weq.local/schemas/export/v1/resource-directory.basic.schema.json",
  "title": "资源目录基本内容",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "kind": {
          "const": "resource-directory"
        },
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "required": ["type", "sourceId", "owner", "name", "resourceIds"],
      "properties": {
        "type": {
          "enum": [
            "folder",
            "file",
            "album",
            "photo",
            "video",
            "emoji-pack",
            "emoji",
            "bubble",
            "font",
            "widget",
            "artifact",
            "report",
            "bot-package"
          ]
        },
        "sourceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/actor"
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "createdAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "resourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
