{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/out",
      "!**/build",
      "!**/release",
      "!**/*.tsbuildinfo",
      "!packages/ninebird",
      "!**/*.css",
      "!resources/bot-runtime",
      "!resources/ninebird-runtime",
      "!resources/hitokoto.json",
      "!resources/assistant/tailwind.runtime.js",
      "!native/**/*.js",
      "!pnpm-lock.yaml",
      "!logs",
      "!scripts/hook_gpro.js",
      "!scripts/decrypt_gpro.cjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false
          }
        }
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/tools/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "useNodejsImportProtocol": "off",
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/renderer/src/components/MsgElementEditor.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/renderer/src/components/relationGraph/RankingModal.tsx",
        "apps/desktop/src/renderer/src/components/relationGraph/GraphCanvas.tsx",
        "apps/desktop/src/renderer/src/im-template/template/messageBubble.tsx",
        "apps/desktop/src/renderer/src/im-template/template/chatPane.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
