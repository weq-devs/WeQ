import type { CSSProperties, ReactElement, ReactNode } from 'react';
import type { InteractionsPageData } from '@weq/service';
import { isAllTimeYear, reportEraLabel } from '@weq/service/report-time';
import { PageFrame, type ReportPageProps } from '../pageFrame';
import { Odometer } from '../Odometer';

function fmt(n: number): string {
  return new Intl.NumberFormat('zh-CN').format(n);
}

/**
 * 群聊互动 —— 这一页的主角不是「热闹」这种人人一样的词，而是数据本身：
 *
 *   从戳一戳 / @ / 被 @ / 复读这四组数据里挑出**数字最大的那组**顶到版心：
 *   每个人看到的主体都不一样，有的人是「@ 过别人 N 次」，有的人是
 *   「最长的一次齐声，N 条」。巨数只属于他自己，文案再负责说出为什么。
 *   下半屏的四行事实仍保留，是主体的证据而不是另一排仪表盘。
 *
 * 翻页动画只有一个声音：巨数从里程表里滚出来，四行事实随后逐行浮起——
 * 数字是这一页的署名，不是它脚下的注脚。
 */
export function InteractionsPage({
  page,
  data,
  active,
}: ReportPageProps<InteractionsPageData>): ReactElement {
  const allTime = isAllTimeYear(data.year);
  const era = allTime ? '有记录以来' : `${data.year} 年`;
  const hero = pickHero(data);
  const hasEvidence =
    data.pokeTotal > 0 ||
    data.atTotal > 0 ||
    data.atMeTotal > 0 ||
    data.echoParticipated > 0 ||
    data.echoLongest != null;

  return (
    <PageFrame
      page={page}
      active={active}
      ghost={hasEvidence && hero ? HERO_GHOST[hero.kind] : '安'}
      tone="#a9563f"
    >
      <div className="weq-it" data-empty={hasEvidence ? 'no' : 'yes'}>
        <header className="weq-it-kicker weq-report-line" style={{ '--i': 1 } as CSSProperties}>
          <span>{reportEraLabel(data.year)} · 群聊互动</span>
          <span className="weq-it-kicker-meta">
            <b className="weq-number">{fmt(data.pokeTotal)}</b> 次戳
            <i>/</i>
            <b className="weq-number">{fmt(data.atTotal)}</b> 次 @<i>/</i>
            <b className="weq-number">{fmt(data.echoParticipated)}</b> 场齐声
          </span>
        </header>

        {hasEvidence ? (
          <>
            <section className="weq-it-hero weq-report-line" style={{ '--i': 2 } as CSSProperties}>
              <p className="weq-it-lede">{era}，热闹里你做得最多的一件事，是——</p>
              <h2 className="weq-it-hero-label" aria-live="polite">
                {hero?.label}
              </h2>
              <p className="weq-it-hero-countline">
                <Odometer
                  value={hero?.count ?? 0}
                  active={active}
                  className="weq-it-hero-num"
                  durationMs={1700}
                />
                <span className="weq-it-hero-unit" aria-hidden>
                  {hero?.unit}
                </span>
              </p>
              {hero ? <p className="weq-it-hero-note">{heroNote(data, hero.kind)}</p> : null}
            </section>

            <section className=”weq-it-score”>
              <FactLine
                label=”戳一戳”
                step={3}
                primary={
                  <>
                    我发起过
                    <Odometer
                      value={data.pokeTotal}
                      active={active}
                      className=”weq-it-od”
                      durationMs={1400}
                    />
                    <i className=”weq-it-fact-unit”>次</i>
                  </>
                }
                secondary={
                  data.pokeTop ? (
                    <>
                      最常吃你一戳的：<em>{data.pokeTop.name}</em>
                      <i> · </i>
                      <b className=”weq-number”>{fmt(data.pokeTop.count)}</b> 次
                    </>
                  ) : (
                    <>这一年，你的手指还没养成戳人的习惯。</>
                  )
                }
              />
              <FactLine
                label=”@ 提及”
                step={4}
                primary={
                  <>
                    我 @ 过别人
                    <Odometer
                      value={data.atTotal}
                      active={active}
                      className=”weq-it-od”
                      durationMs={1400}
                    />
                    <i className=”weq-it-fact-unit”>次</i>
                  </>
                }
                secondary={
                  data.atTop ? (
                    <>
                      被你喊得最响的：<em>{data.atTop.name}</em>
                      <i> · </i>
                      <b className=”weq-number”>{fmt(data.atTop.count)}</b> 次
                    </>
                  ) : (
                    <>这一年，你还不太习惯在人群里喊出某个名字。</>
                  )
                }
              />
              <FactLine
                label=”被 @”
                step={5}
                primary={
                  data.atMeTop ? (
                    <>
                      最多在 <em className=”weq-it-group”>{data.atMeTop.groupName}</em>
                    </>
                  ) : (
                    <>这一年，还没有哪个群反复喊你的名字。</>
                  )
                }
                secondary={
                  data.atMeTop ? (
                    <>
                      那里有 <b className=”weq-number”>{fmt(data.atMeTop.count)}</b> 次，有人在
                      人群里，专门喊了你的名字。
                    </>
                  ) : (
                    <>下一次开场，从你 @ 别人开始。</>
                  )
                }
              />
              <FactLine
                label=”复读”
                step={6}
                primary={
                  <>
                    我跟过
                    <Odometer
                      value={data.echoParticipated}
                      active={active}
                      className=”weq-it-od”
                      durationMs={1400}
                    />
                    <i className=”weq-it-fact-unit”>场</i>
                  </>
                }
                secondary={
                  data.echoLongest ? (
                    <>
                      最长一轮在 <em className=”weq-it-group”>{data.echoLongest.groupName}</em>：
                      <b className=”weq-number”>{fmt(data.echoLongest.count)}</b> 条
                      <span className=”weq-it-echo-text”>”{data.echoLongest.text}”</span>
                    </>
                  ) : (
                    <>这一年没有足够长的齐声——热闹的下一条，可能由你开头。</>
                  )
                }
              />
            </section>

            <p className="weq-it-mood weq-report-line" style={{ '--i': 7 } as CSSProperties}>
              你留在群里的，从来不只是话。每一次伸手、被点名、跟着起哄——都是「那年我也在」的证据。
            </p>
          </>
        ) : (
          <section className="weq-it-hero weq-report-line" style={{ '--i': 2 } as CSSProperties}>
            <p className="weq-it-lede">{era}，你在群聊里更多是安静地看——</p>
            <h2 className="weq-it-hero-label">你还没留下可统计的互动</h2>
            <p className="weq-it-hero-note">
              潜水也很好，但偶尔浮上来冒个泡——下一条消息，可以从你开始。
            </p>
          </section>
        )}
      </div>
    </PageFrame>
  );
}

/** 四组统计在版心里的“署名”。 */
type HeroKind = 'at' | 'called' | 'poke' | 'echo';

const HERO_GHOST: Record<HeroKind, string> = {
  at: '@',
  called: '呼',
  poke: '戳',
  echo: '齐',
};

/**
 * 从四组统计里挑数字最大的那组做主体。
 *
 * 戳一戳 / @ / 被 @ 都看自己的总量；复读看「跟过的场数」与「最长一轮条数」
 * 里更大的那个 —— 这样版心那个巨数一定是整页视觉上最重的一枚。
 * 并列时按 at → called → poke → echo 的次序偏向前者，避免随机跳。
 */
function pickHero(data: InteractionsPageData): {
  kind: HeroKind;
  count: number;
  unit: string;
  label: string;
} | null {
  const echoCount = Math.max(data.echoParticipated, data.echoLongest?.count ?? 0);
  const candidates: Array<{ kind: HeroKind; count: number }> = [
    { kind: 'at', count: data.atTotal },
    { kind: 'called', count: data.atMeTotal },
    { kind: 'poke', count: data.pokeTotal },
    { kind: 'echo', count: echoCount },
  ];

  let best: (typeof candidates)[number] | null = null;
  for (const candidate of candidates) {
    if (!best || candidate.count > best.count) best = candidate;
  }
  if (!best || best.count <= 0) return null;

  switch (best.kind) {
    case 'at':
      return { kind: 'at', count: data.atTotal, unit: '次', label: '我 @ 过别人' };
    case 'called':
      return { kind: 'called', count: data.atMeTotal, unit: '次', label: '我被人点名过' };
    case 'poke':
      return { kind: 'poke', count: data.pokeTotal, unit: '次', label: '我发起过戳一戳' };
    case 'echo': {
      const longest = data.echoLongest?.count ?? 0;
      if (longest > data.echoParticipated && data.echoLongest) {
        return { kind: 'echo', count: longest, unit: '条', label: '最长的一次齐声' };
      }
      return { kind: 'echo', count: data.echoParticipated, unit: '场', label: '我跟上过复读' };
    }
  }
}

/** 主体下面那句“为什么”——只讲赢家的故事，别把四种统计再念一遍。 */
function heroNote(data: InteractionsPageData, kind: HeroKind): ReactNode {
  switch (kind) {
    case 'at':
      return data.atTop ? (
        <>
          名字喊得最响的是 <em>{data.atTop.name}</em>
          <i aria-hidden> · </i>
          <b className="weq-number">{fmt(data.atTop.count)}</b> 次 ——@
          是怕你错过，才把名字放到人前。
        </>
      ) : (
        <>这一年你 @ 得不多——但每一次，都是怕有人错过。</>
      );
    case 'called':
      return data.atMeTop ? (
        <>
          最多发生在 <em>{data.atMeTop.groupName}</em>
          <i aria-hidden> · </i>
          <b className="weq-number">{fmt(data.atMeTop.count)}</b> 次
          ——被点名，是被人想起的最短路径。
        </>
      ) : (
        <>名字被念起的次数还不多——但每一次，都有人记得你。</>
      );
    case 'poke':
      return data.pokeTop ? (
        <>
          最常被你戳到 <em>{data.pokeTop.name}</em>
          <i aria-hidden> · </i>
          <b className="weq-number">{fmt(data.pokeTop.count)}</b> 次 ——戳一戳是最轻的搭话。
        </>
      ) : (
        <>这一年你伸出的手不多——但每一下，都先越过了屏幕。</>
      );
    case 'echo': {
      const longest = data.echoLongest;
      if (longest && longest.count > data.echoParticipated) {
        return (
          <>
            在 <em>{longest.groupName}</em>，大家把
            <b className="weq-echo-quote">“{longest.text}”</b> 连说了{' '}
            <b className="weq-number">{fmt(longest.count)}</b> 次
            ——一句话被那么多人接住，就不再只是一个人的了。
          </>
        );
      }
      return data.echoLongest ? (
        <>
          最长一轮在 <em>{data.echoLongest.groupName}</em>，连了{' '}
          <b className="weq-number">{fmt(data.echoLongest.count)}</b> 条
          ——不想一个人笑的时候，你跟着大家开了口。
        </>
      ) : (
        <>这一年你跟着大家开过 {fmt(data.echoParticipated)} 次口——齐声最不怕吵。</>
      );
    }
  }
}

/** 一行”发生的事”：左边标签，右边一句话 + 一行小注。 */
function FactLine({
  label,
  step,
  primary,
  secondary,
}: {
  label: string;
  step: number;
  primary: ReactNode;
  secondary: ReactNode;
}): ReactElement {
  return (
    <p className=”weq-it-fact weq-report-line” style={{ '--i': step } as CSSProperties}>
      <span className=”weq-it-fact-body”>
        <span className=”weq-it-fact-label”>{label}</span>
        <span className=”weq-it-fact-main”>{primary}</span>
        <span className=”weq-it-fact-sub”>{secondary}</span>
      </span>
    </p>
  );
}
